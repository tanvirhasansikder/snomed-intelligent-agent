diff --git a/evaluation/benchmark.py b/evaluation/benchmark.py
index e69de29..bfcebbc 100644
--- a/evaluation/benchmark.py
+++ b/evaluation/benchmark.py
@@ -0,0 +1,283 @@
+"""
+Reproducible benchmark framework for SNOMED CT hierarchy questions.
+
+Status: framework only. No real benchmark has been built or run in this
+project yet, and no results exist. See docs/EVALUATION_PROTOCOL.md.
+
+Pipeline
+--------
+1. build_gold_snapshot(client, concept_ids)  -> GoldSnapshot
+   Fetches, for each sampled concept: label, direct parents, direct children
+   (complete or flagged truncated) and the full ancestor set, plus the
+   BioPortal release version. Failures are recorded, never silently dropped.
+2. GoldSnapshot.save(path) / GoldSnapshot.load(path)
+   Freezes the gold data with provenance so later runs do not depend on live
+   BioPortal. Snapshots contain SNOMED CT content: keep them out of git and
+   check the licence before sharing (default folder data/gold/ is ignored).
+3. generate_items(snapshot, seed)            -> list[BenchmarkItem]
+   T1 direct parents, T2 direct children (only if complete), T3 "is X a kind
+   of Y" with positive and random negative pairs. Deterministic for a seed.
+4. answer_from_graph(items, graph)           -> predictions
+   Reference system "R0": answers from a local graph (e.g. the Neo4j subgraph
+   produced by the crawler). Use it to measure the effect of retrieval
+   completeness without any LLM.
+5. evaluate(items, predictions)              -> metrics per task
+"""
+
+import argparse
+import json
+import random
+from dataclasses import asdict, dataclass, field
+from datetime import datetime, timezone
+from pathlib import Path
+
+from crawler.bioportal_client import BioPortalError
+from evaluation.metrics import accuracy, macro_average, set_prf
+from explanation.explainer import ReferenceHierarchy
+
+SCHEMA_VERSION = "1.0"
+TASKS = ("T1_direct_parents", "T2_direct_children", "T3_is_a")
+DEFAULT_GOLD_DIR = Path(__file__).resolve().parent.parent / "data" / "gold"
+MAX_LIVE_CONCEPTS = 50  # guard against accidental large crawls
+
+
+def _utc_now():
+    return datetime.now(timezone.utc).isoformat(timespec="seconds")
+
+
+# ============================================================
+# Gold snapshot
+# ============================================================
+
+@dataclass
+class GoldConcept:
+    concept_id: str
+    label: str
+    parents: list
+    children: list = None            # None if not retrieved
+    children_complete: bool = False
+    ancestors: list = None           # None if not retrieved
+
+
+@dataclass
+class GoldSnapshot:
+    source: str
+    ontology: str
+    version: str = None
+    released: str = None
+    retrieved_at: str = None
+    synthetic: bool = False
+    notes: str = ""
+    concepts: dict = field(default_factory=dict)    # concept_id -> GoldConcept
+    labels: dict = field(default_factory=dict)      # every ID seen -> label
+    failures: dict = field(default_factory=dict)    # concept_id -> reason
+    schema_version: str = SCHEMA_VERSION
+
+    def to_dict(self):
+        data = asdict(self)
+        data["concepts"] = {cid: asdict(c) for cid, c in self.concepts.items()}
+        return data
+
+    @classmethod
+    def from_dict(cls, data):
+        if data.get("schema_version") != SCHEMA_VERSION:
+            raise ValueError(f"Unsupported gold snapshot schema version: {data.get('schema_version')}")
+        concepts = {cid: GoldConcept(**c) for cid, c in data.get("concepts", {}).items()}
+        fields = {k: v for k, v in data.items() if k != "concepts"}
+        return cls(concepts=concepts, **fields)
+
+    def save(self, path):
+        path = Path(path)
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(self.to_dict(), indent=2, sort_keys=True), encoding="utf-8")
+        return path
+
+    @classmethod
+    def load(cls, path):
+        return cls.from_dict(json.loads(Path(path).read_text(encoding="utf-8")))
+
+    def reference_hierarchy(self):
+        """Trusted hierarchy for the claim verifier (explanation.explainer)."""
+        edges = set()
+        ancestor_sets = {}
+        for c in self.concepts.values():
+            edges.update((c.concept_id, p) for p in c.parents)
+            if c.children_complete and c.children is not None:
+                edges.update((child, c.concept_id) for child in c.children)
+            if c.ancestors is not None:
+                ancestor_sets[c.concept_id] = c.ancestors
+        return ReferenceHierarchy(edges, nodes=self.labels.keys(), ancestor_sets=ancestor_sets)
+
+
+def build_gold_snapshot(client, concept_ids, max_child_pages=10, notes="", allow_large=False):
+    """
+    Fetch gold data for ``concept_ids`` with strict error handling.
+
+    A concept with any failed request is recorded in ``failures`` and left out
+    of ``concepts`` (it is never stored with partial gold answers).
+    """
+
+    concept_ids = list(dict.fromkeys(str(c).strip() for c in concept_ids if str(c).strip()))
+    if len(concept_ids) > MAX_LIVE_CONCEPTS and not allow_large:
+        raise ValueError(f"Refusing to fetch more than {MAX_LIVE_CONCEPTS} concepts without allow_large=True")
+
+    version = client.get_ontology_version() if hasattr(client, "get_ontology_version") else None
+    snapshot = GoldSnapshot(
+        source="BioPortal REST API",
+        ontology="SNOMEDCT",
+        version=(version or {}).get("version"),
+        released=(version or {}).get("released"),
+        retrieved_at=_utc_now(),
+        notes=notes,
+    )
+
+    for concept_id in concept_ids:
+        try:
+            concept = client.get_concept(concept_id, raise_errors=True)
+            if not concept:
+                snapshot.failures[concept_id] = "not found"
+                continue
+            label = concept.get("prefLabel") or concept_id
+            parents = client.get_parents(concept_id, raise_errors=True)
+            children = client.fetch_children(concept_id, max_pages=max_child_pages)
+            ancestors = client.get_ancestors(concept_id, raise_errors=True)
+        except BioPortalError as exc:
+            snapshot.failures[concept_id] = str(exc)
+            continue
+
+        snapshot.labels[concept_id] = label
+        for record in list(parents) + list(children["children"]) + list(ancestors):
+            snapshot.labels.setdefault(record["concept_id"], record.get("name") or record["concept_id"])
+
+        snapshot.concepts[concept_id] = GoldConcept(
+            concept_id=concept_id,
+            label=label,
+            parents=sorted(p["concept_id"] for p in parents),
+            children=sorted(c["concept_id"] for c in children["children"]),
+            children_complete=bool(children["complete"]),
+            ancestors=sorted(a["concept_id"] for a in ancestors),
+        )
+
+    return snapshot
+
+
+# ============================================================
+# Items
+# ============================================================
+
+@dataclass
+class BenchmarkItem:
+    item_id: str
+    task: str
+    concept_id: str
+    gold: object                      # list of IDs (T1/T2) or bool (T3)
+    target_id: str = None             # T3 only
+    negative_type: str = None         # T3 negatives: "random"
+
+    def to_dict(self):
+        return asdict(self)
+
+
+def generate_items(snapshot, seed=0):
+    """Deterministic items for T1, T2 and T3 from a gold snapshot."""
+
+    rng = random.Random(seed)
+    items = []
+    concept_ids = sorted(snapshot.concepts)
+
+    for cid in concept_ids:
+        concept = snapshot.concepts[cid]
+        items.append(BenchmarkItem(f"T1-{cid}", "T1_direct_parents", cid, sorted(concept.parents)))
+
+        if concept.children is not None and concept.children_complete:
+            items.append(BenchmarkItem(f"T2-{cid}", "T2_direct_children", cid, sorted(concept.children)))
+
+        if concept.ancestors:
+            positive = rng.choice(sorted(concept.ancestors))
+            items.append(BenchmarkItem(f"T3-{cid}-pos", "T3_is_a", cid, True, target_id=positive))
+
+            excluded = set(concept.ancestors) | {cid}
+            negatives = [
+                other for other in concept_ids
+                if other not in excluded
+                and cid not in (snapshot.concepts[other].ancestors or [])
+            ]
+            if negatives:
+                negative = rng.choice(negatives)
+                items.append(BenchmarkItem(f"T3-{cid}-neg", "T3_is_a", cid, False,
+                                           target_id=negative, negative_type="random"))
+
+    return items
+
+
+# ============================================================
+# Reference system R0: answer from a local graph
+# ============================================================
+
+def answer_from_graph(items, graph, max_depth=20):
+    """
+    Answer items using only what ``graph`` stores (GraphRepository or any
+    object with get_parents / get_children / get_ancestors).
+    """
+    predictions = {}
+    for item in items:
+        if item.task == "T1_direct_parents":
+            predictions[item.item_id] = sorted(p["concept_id"] for p in graph.get_parents(item.concept_id))
+        elif item.task == "T2_direct_children":
+            predictions[item.item_id] = sorted(c["concept_id"] for c in graph.get_children(item.concept_id))
+        elif item.task == "T3_is_a":
+            ancestors = {a["concept_id"] for a in graph.get_ancestors(item.concept_id, max_depth=max_depth)}
+            predictions[item.item_id] = item.target_id in ancestors
+    return predictions
+
+
+# ============================================================
+# Scoring
+# ============================================================
+
+def evaluate(items, predictions):
+    """
+    Score predictions. A missing prediction counts as an empty answer (T1/T2)
+    or as wrong (T3), and is counted in ``missing``.
+    """
+
+    report = {}
+    for task in TASKS:
+        task_items = [i for i in items if i.task == task]
+        missing = sum(1 for i in task_items if i.item_id not in predictions)
+        if task in ("T1_direct_parents", "T2_direct_children"):
+            rows = [set_prf(predictions.get(i.item_id, []), i.gold) for i in task_items]
+            report[task] = {"n": len(task_items), "missing": missing, **macro_average(rows)}
+        else:
+            predicted = [predictions.get(i.item_id) for i in task_items]
+            gold = [i.gold for i in task_items]
+            report[task] = {"n": len(task_items), "missing": missing, "accuracy": accuracy(predicted, gold)}
+    return report
+
+
+# ============================================================
+# Command line: build a gold snapshot (LIVE, bounded)
+# ============================================================
+
+def _main(argv=None):
+    parser = argparse.ArgumentParser(description="Build a frozen gold snapshot from BioPortal (live requests).")
+    parser.add_argument("--ids", required=True, help="Text file with one SNOMED CT concept ID per line")
+    parser.add_argument("--out", default=str(DEFAULT_GOLD_DIR / "snapshot.json"))
+    parser.add_argument("--live", action="store_true", help="Required: confirms you want to call BioPortal")
+    args = parser.parse_args(argv)
+
+    if not args.live:
+        parser.error("add --live to confirm that BioPortal will be contacted")
+
+    from crawler.bioportal_client import BioPortalClient
+
+    ids = Path(args.ids).read_text(encoding="utf-8").split()
+    client = BioPortalClient()
+    snapshot = build_gold_snapshot(client, ids)
+    path = snapshot.save(args.out)
+    print(f"Saved {len(snapshot.concepts)} concepts ({len(snapshot.failures)} failures) to {path}")
+    print(f"BioPortal requests: {client.request_count}; release: {snapshot.version}")
+
+
+if __name__ == "__main__":
+    _main()
diff --git a/evaluation/metrics.py b/evaluation/metrics.py
index e69de29..303a65f 100644
--- a/evaluation/metrics.py
+++ b/evaluation/metrics.py
@@ -0,0 +1,143 @@
+"""
+Evaluation metrics (pure functions, no I/O).
+
+Conventions for empty sets, fixed here so results are reproducible:
+* precision = |pred ∩ gold| / |pred|; if pred is empty it is 1.0 when gold
+  is also empty, else 0.0 (an empty answer to a non-empty question is wrong).
+* recall    = |pred ∩ gold| / |gold|; if gold is empty it is 1.0 when pred
+  is also empty, else 0.0.
+* F1 is the harmonic mean, 0.0 when precision + recall == 0.
+"""
+
+import random
+from collections import Counter
+
+from explanation.explainer import (
+    CONTRADICTED,
+    FALSE_IN_REFERENCE,
+    INSUFFICIENT,
+    LABELS,
+    SUPPORTED,
+    TRUE_NOT_RETRIEVED,
+    UNKNOWN_IDENTIFIER,
+)
+
+
+def set_prf(predicted, gold):
+    """Precision, recall and F1 for two collections of hashable items."""
+    pred, true = set(predicted), set(gold)
+    hits = len(pred & true)
+    if pred:
+        precision = hits / len(pred)
+    else:
+        precision = 1.0 if not true else 0.0
+    if true:
+        recall = hits / len(true)
+    else:
+        recall = 1.0 if not pred else 0.0
+    f1 = 0.0 if precision + recall == 0 else 2 * precision * recall / (precision + recall)
+    return {"precision": precision, "recall": recall, "f1": f1}
+
+
+def macro_average(rows, keys=("precision", "recall", "f1")):
+    """Mean of each key over a list of metric dicts (empty list -> None values)."""
+    if not rows:
+        return {k: None for k in keys}
+    return {k: sum(r[k] for r in rows) / len(rows) for k in keys}
+
+
+def accuracy(predicted, gold):
+    """Share of positions where predicted == gold. Lengths must match."""
+    if len(predicted) != len(gold):
+        raise ValueError("predicted and gold must have the same length")
+    if not gold:
+        return None
+    return sum(p == g for p, g in zip(predicted, gold)) / len(gold)
+
+
+def path_edges(path):
+    """[a, b, c] -> {(a, b), (b, c)}."""
+    return {(path[i], path[i + 1]) for i in range(len(path) - 1)}
+
+
+def path_edge_f1(predicted_path, gold_path):
+    """Edge-level P/R/F1 between two hierarchy paths (lists of concept IDs)."""
+    return set_prf(path_edges(predicted_path), path_edges(gold_path))
+
+
+def exact_match(predicted, gold):
+    return list(predicted) == list(gold)
+
+
+def claim_label_rates(labels):
+    """
+    Rates over verifier labels (see explanation.explainer.LABELS).
+
+    unsupported_rate = share of claims NOT supported by the retrieved subgraph.
+    false_claim_rate = share of claims false in the reference
+                       (false_in_reference + unknown_identifier).
+    Rates are None when there are no claims.
+    """
+    counts = Counter(labels)
+    unknown = set(counts) - set(LABELS)
+    if unknown:
+        raise ValueError(f"unknown labels: {sorted(unknown)}")
+    total = sum(counts.values())
+    if total == 0:
+        return {"n_claims": 0, "unsupported_rate": None, "false_claim_rate": None,
+                **{f"rate_{label}": None for label in LABELS}}
+    rates = {f"rate_{label}": counts[label] / total for label in LABELS}
+    return {
+        "n_claims": total,
+        "unsupported_rate": 1 - counts[SUPPORTED] / total,
+        "false_claim_rate": (counts[FALSE_IN_REFERENCE] + counts[UNKNOWN_IDENTIFIER]) / total,
+        **rates,
+    }
+
+
+def identifier_hallucination_rate(cited_ids, known_ids):
+    """Share of cited concept IDs that are not in ``known_ids`` (None if none cited)."""
+    cited = list(cited_ids)
+    if not cited:
+        return None
+    known = set(known_ids)
+    return sum(1 for cid in cited if cid not in known) / len(cited)
+
+
+def citation_precision_recall(cited_edges, required_edges, retrieved_edges):
+    """
+    Edge-citation quality, adapted from ALCE-style citation metrics.
+
+    precision: share of cited edges that exist in the retrieved evidence.
+    recall:    share of required edges (those the claims depend on) that were cited.
+    """
+    cited, required, retrieved = set(cited_edges), set(required_edges), set(retrieved_edges)
+    precision = (len(cited & retrieved) / len(cited)) if cited else None
+    recall = (len(cited & required) / len(required)) if required else None
+    return {"citation_precision": precision, "citation_recall": recall}
+
+
+def bootstrap_ci(values, n_resamples=1000, confidence=0.95, seed=0):
+    """Percentile bootstrap CI of the mean; deterministic for a given seed."""
+    data = [v for v in values if v is not None]
+    if not data:
+        return None
+    rng = random.Random(seed)
+    means = sorted(
+        sum(rng.choice(data) for _ in data) / len(data)
+        for _ in range(n_resamples)
+    )
+    lower_index = int((1 - confidence) / 2 * n_resamples)
+    upper_index = min(n_resamples - 1, int((1 + confidence) / 2 * n_resamples))
+    return {"mean": sum(data) / len(data), "lower": means[lower_index], "upper": means[upper_index],
+            "n": len(data), "seed": seed, "n_resamples": n_resamples}
+
+
+# Re-exported so callers can reference labels without importing explanation.
+CLAIM_LABELS = LABELS
+__all__ = [
+    "set_prf", "macro_average", "accuracy", "path_edges", "path_edge_f1", "exact_match",
+    "claim_label_rates", "identifier_hallucination_rate", "citation_precision_recall",
+    "bootstrap_ci", "CLAIM_LABELS", "SUPPORTED", "TRUE_NOT_RETRIEVED", "FALSE_IN_REFERENCE",
+    "CONTRADICTED", "INSUFFICIENT", "UNKNOWN_IDENTIFIER",
+]
diff --git a/explanation/explainer.py b/explanation/explainer.py
index e69de29..47f1d7c 100644
--- a/explanation/explainer.py
+++ b/explanation/explainer.py
@@ -0,0 +1,221 @@
+"""
+Deterministic verification of hierarchy claims (no LLM involved).
+
+A *claim* says that ``object_id`` is a direct parent or an ancestor of
+``subject_id`` (i.e. subject IS_A object, directly or transitively). The
+verifier labels each claim against
+
+* the retrieved subgraph (``SubgraphEvidence``), which may be incomplete, and
+* optionally a reference hierarchy (``ReferenceHierarchy``, e.g. a frozen
+  gold snapshot), used only for evaluation.
+
+Labels
+------
+supported_by_subgraph            the retrieved edges entail the claim
+true_not_retrieved               not in the subgraph, but true in the reference
+false_in_reference               not in the subgraph and false in the reference
+contradicted_by_complete_evidence  no reference given, but the subject's
+                                 parents (or full ancestor closure) were
+                                 retrieved completely and do not include it
+insufficient_evidence            cannot be decided from the evidence
+unknown_identifier               an ID that does not exist in the reference
+
+Without a reference the verifier never claims a statement is false unless the
+relevant evidence is known to be complete. This is the rule that keeps an
+incomplete local graph from being read as proof of absence.
+"""
+
+from collections import deque
+from dataclasses import dataclass
+
+DIRECT_PARENT = "direct_parent"
+ANCESTOR = "ancestor"
+RELATIONS = (DIRECT_PARENT, ANCESTOR)
+
+SUPPORTED = "supported_by_subgraph"
+TRUE_NOT_RETRIEVED = "true_not_retrieved"
+FALSE_IN_REFERENCE = "false_in_reference"
+CONTRADICTED = "contradicted_by_complete_evidence"
+INSUFFICIENT = "insufficient_evidence"
+UNKNOWN_IDENTIFIER = "unknown_identifier"
+
+LABELS = (SUPPORTED, TRUE_NOT_RETRIEVED, FALSE_IN_REFERENCE, CONTRADICTED, INSUFFICIENT, UNKNOWN_IDENTIFIER)
+
+
+def _is_concept_id(value):
+    return isinstance(value, str) and value.isdigit()
+
+
+@dataclass(frozen=True)
+class HierarchyClaim:
+    subject_id: str
+    relation: str
+    object_id: str
+
+    def __post_init__(self):
+        if self.relation not in RELATIONS:
+            raise ValueError(f"relation must be one of {RELATIONS}")
+        if not _is_concept_id(self.subject_id) or not _is_concept_id(self.object_id):
+            raise ValueError("subject_id and object_id must be numeric concept ID strings")
+
+    def as_dict(self):
+        return {"subject": self.subject_id, "relation": self.relation, "object": self.object_id}
+
+
+def parse_claims(records):
+    """
+    Build claims from dicts {'subject', 'relation', 'object'} (for example a
+    structured LLM output). Raises ValueError on the first invalid record.
+    """
+    claims = []
+    for index, record in enumerate(records):
+        if not isinstance(record, dict):
+            raise ValueError(f"claim {index} is not an object")
+        try:
+            claims.append(HierarchyClaim(str(record["subject"]), record["relation"], str(record["object"])))
+        except KeyError as exc:
+            raise ValueError(f"claim {index} is missing {exc}") from None
+    return claims
+
+
+class _Hierarchy:
+    """Shared reachability over (child, parent) edges."""
+
+    def __init__(self, edges):
+        self.parents = {}
+        for child, parent in edges:
+            self.parents.setdefault(child, set()).add(parent)
+
+    def has_edge(self, child, parent):
+        return parent in self.parents.get(child, ())
+
+    def ancestors(self, concept_id):
+        seen, queue = set(), deque([concept_id])
+        while queue:
+            for parent in self.parents.get(queue.popleft(), ()):
+                if parent not in seen:
+                    seen.add(parent)
+                    queue.append(parent)
+        return seen
+
+
+class SubgraphEvidence(_Hierarchy):
+    """
+    What was actually retrieved.
+
+    nodes             concept_id -> label
+    edges             (child_id, parent_id) IS_A edges
+    parents_complete  IDs whose full direct-parent list was retrieved
+    """
+
+    def __init__(self, nodes, edges, parents_complete=()):
+        edges = set(edges)
+        super().__init__(edges)
+        self.nodes = dict(nodes)
+        self.edges = edges
+        self.parents_complete = set(parents_complete)
+
+    def closure_complete(self, concept_id):
+        """True if every concept on every upward path has a complete parent list."""
+        if concept_id not in self.parents_complete:
+            return False
+        return all(a in self.parents_complete for a in self.ancestors(concept_id))
+
+    @classmethod
+    def from_query_result(cls, result):
+        """
+        Evidence from a QueryProcessor result: the focal concept, its direct
+        parents and children. Ancestors beyond direct parents are *not* turned
+        into edges, because the result does not say which edge links them.
+        """
+        concept = result.get("concept") or {}
+        focal = concept.get("concept_id")
+        nodes = {focal: concept.get("name")} if focal else {}
+        edges = set()
+        for parent in result.get("parents") or []:
+            nodes[parent["concept_id"]] = parent.get("name")
+            edges.add((focal, parent["concept_id"]))
+        for child in result.get("children") or []:
+            nodes[child["concept_id"]] = child.get("name")
+            edges.add((child["concept_id"], focal))
+        complete = set()
+        parents_coverage = (result.get("coverage") or {}).get("parents") or {}
+        if focal and parents_coverage.get("status") == "complete":
+            complete.add(focal)
+        return cls(nodes, edges, complete)
+
+
+class ReferenceHierarchy(_Hierarchy):
+    """
+    A trusted hierarchy used for evaluation (e.g. a frozen gold snapshot).
+
+    ``ancestor_sets`` optionally gives the full ancestor set of some concepts
+    (as returned by BioPortal /ancestors), so their closure does not depend on
+    every intermediate parent list being present.
+    """
+
+    def __init__(self, edges, nodes=None, ancestor_sets=None):
+        edges = set(edges)
+        super().__init__(edges)
+        self.ancestor_sets = {k: set(v) for k, v in (ancestor_sets or {}).items()}
+        known = set(nodes or ())
+        for child, parent in edges:
+            known.update((child, parent))
+        for concept_id, ancestors in self.ancestor_sets.items():
+            known.add(concept_id)
+            known.update(ancestors)
+        self.nodes = known
+
+    def is_ancestor(self, concept_id, candidate):
+        if concept_id in self.ancestor_sets:
+            return candidate in self.ancestor_sets[concept_id]
+        return candidate in self.ancestors(concept_id)
+
+
+def verify_claim(claim, evidence, reference=None):
+    """Return one label from LABELS for ``claim``."""
+
+    if reference is not None and (claim.subject_id not in reference.nodes or claim.object_id not in reference.nodes):
+        return UNKNOWN_IDENTIFIER
+
+    if claim.relation == DIRECT_PARENT:
+        supported = evidence.has_edge(claim.subject_id, claim.object_id)
+    else:
+        supported = claim.object_id in evidence.ancestors(claim.subject_id)
+
+    if supported:
+        return SUPPORTED
+
+    if reference is not None:
+        if claim.relation == DIRECT_PARENT:
+            true = reference.has_edge(claim.subject_id, claim.object_id)
+        else:
+            true = reference.is_ancestor(claim.subject_id, claim.object_id)
+        return TRUE_NOT_RETRIEVED if true else FALSE_IN_REFERENCE
+
+    if claim.subject_id not in evidence.nodes:
+        return INSUFFICIENT
+
+    if claim.relation == DIRECT_PARENT and claim.subject_id in evidence.parents_complete:
+        return CONTRADICTED
+
+    if claim.relation == ANCESTOR and evidence.closure_complete(claim.subject_id):
+        return CONTRADICTED
+
+    return INSUFFICIENT
+
+
+def verify_claims(claims, evidence, reference=None):
+    """Return a list of {'claim': {...}, 'label': ...} in input order."""
+    return [{"claim": c.as_dict(), "label": verify_claim(c, evidence, reference)} for c in claims]
+
+
+def filter_supported(claims, evidence):
+    """
+    Keep only claims supported by the retrieved subgraph. Intended as the
+    guard between a future LLM layer and anything shown or stored as fact.
+    """
+    kept, removed = [], []
+    for claim in claims:
+        (kept if verify_claim(claim, evidence) == SUPPORTED else removed).append(claim)
+    return kept, removed

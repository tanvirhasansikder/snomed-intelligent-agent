# Copy this file to .env (same folder as main.py) and fill in real values.
# Never commit .env.

# BioPortal API key (https://bioportal.bioontology.org/account)
BIOPORTAL_API_KEY=

# Local Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Optional: a named database (leave empty for the default database)
NEO4J_DATABASE=
